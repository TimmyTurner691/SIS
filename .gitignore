# --- 1. Python (Basura generada por el lenguaje) ---
__pycache__/
*.pyc
*.pyo
.env
venv/

# --- 2. Logs y Evidencias (NUEVA ESTRUCTURA) ---
# Ignoramos todo el contenido de la carpeta de logs
logs/*
# Pero (opcional) mantenemos la carpeta vacía para que exista en el repo
!logs/.gitkeep

# Ignoramos archivos de logs sueltos por si acaso
*.log

# --- 3. Capturas de Tráfico (PCAP) ---
# Generalmente no queremos subir pcaps gigantes
*.pcap
# ¡EXCEPCIÓN! Queremos subir estos específicos para demo (descomenta si quieres subirlos):
 !pcap/evidencia.pcap
 !pcap/iec104_test.pcap

# --- 4. Docker y Bases de Datos ---
# Ignorar volúmenes de datos persistentes (Elasticsearch/Redis)
elastic_data/
redis_data/
.docker/

# --- 5. Sistema Operativo ---
.DS_Store
Thumbs.db

# --- 6. Scripts Viejos/Temporales ---
# Solo ignora estos si realmente son basura y NO son los que usas ahora
script_scapy_iec104.py
atacante.py
iec_104_simple.py
