# Paquete: Windows
# SIS expanded Snort rules - windows.rules
# Reserved SID block: 1100301-1100399.
# Keep this range exclusive to Windows to prevent collisions with other SIS packages.
# Validate with `snort -T` and tune rate/noise thresholds after baselining.

# Original SIS starter rules (stable SIDs).
alert tcp any any -> any 3389 (msg:"SIS Windows RDP detectado"; flags:S; sid:1100301; rev:1;)
alert tcp any any -> any 445 (msg:"SIS Windows SMB detectado"; flow:to_server; sid:1100302; rev:1;)

