# SIS expanded Snort rules - smb.rules
# Reserved SID block: 1100701-1100799.
# Keep this range exclusive to SMB to prevent collisions with other SIS packages.
# Validate with `snort -T` and tune rate/noise thresholds after baselining.

# Original SIS starter rules (stable SIDs).
alert tcp any any -> any 445 (msg:"SIS SMB negociacion detectada"; content:"|FF|SMB"; sid:1100701; rev:1;)
alert tcp any any -> any 445 (msg:"SIS SMB2 negociacion detectada"; content:"|FE|SMB"; sid:1100702; rev:1;)

# Expanded SIS rules (collision-free SMB block).
alert tcp any any -> any [139,445] (msg:"SIS SMB1 protocol observed"; flow:to_server,established; content:"|FF 53 4D 42|"; classtype:policy-violation; sid:1100703; rev:1;)
alert tcp any any -> any [139,445] (msg:"SIS SMB2 protocol observed"; flow:to_server,established; content:"|FE 53 4D 42|"; classtype:misc-activity; sid:1100704; rev:1;)
alert tcp any any -> any 445 (msg:"SIS SMB inbound connection rate possible scan"; flags:S; detection_filter:track by_src,count 40,seconds 60; classtype:attempted-recon; sid:1100705; rev:1;)
alert tcp any any -> any 445 (msg:"SIS SMB possible brute force/session storm"; flow:to_server,established; content:"NTLMSSP"; detection_filter:track by_src,count 25,seconds 60; classtype:attempted-admin; sid:1100706; rev:1;)
alert tcp any any -> any [139,445] (msg:"SIS SMB admin share ADMIN dollar access"; flow:to_server,established; content:"ADMIN$"; nocase; classtype:attempted-admin; sid:1100707; rev:1;)
alert tcp any any -> any [139,445] (msg:"SIS SMB admin share C dollar access"; flow:to_server,established; content:"C$"; nocase; classtype:attempted-admin; sid:1100708; rev:1;)
alert tcp any any -> any [139,445] (msg:"SIS SMB admin share IPC dollar access"; flow:to_server,established; content:"IPC$"; nocase; classtype:attempted-admin; sid:1100709; rev:1;)
