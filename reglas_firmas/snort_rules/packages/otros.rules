# SIS expanded Snort rules - otros.rules
# Reserved SID block: 1100801-1100899.
# Keep this range exclusive to Otros to prevent collisions with other SIS packages.
# Validate with `snort -T` and tune rate/noise thresholds after baselining.

# Original SIS starter rules (stable SIDs).
alert tcp any any -> any any (msg:"SIS exploit generico detectado"; content:"exploit"; nocase; sid:1100801; rev:1;)
alert icmp any any -> any any (msg:"SIS ICMP detectado"; sid:1100802; rev:1;)

# Expanded SIS rules (collision-free Otros block).
alert icmp any any -> any any (msg:"SIS OTROS ICMP echo high rate possible ping flood"; itype:8; detection_filter:track by_src,count 100,seconds 10; classtype:attempted-dos; sid:1100803; rev:1;)
alert icmp any any -> any any (msg:"SIS OTROS ICMP large echo request possible ping of death"; itype:8; dsize:>1200; classtype:attempted-dos; sid:1100804; rev:1;)
alert tcp any any -> any any (msg:"SIS OTROS TCP SYN flood pattern from source"; flags:S; detection_filter:track by_src,count 200,seconds 10; classtype:attempted-dos; sid:1100805; rev:1;)
alert udp any any -> any any (msg:"SIS OTROS UDP flood pattern from source"; detection_filter:track by_src,count 500,seconds 10; classtype:attempted-dos; sid:1100806; rev:1;)
alert tcp any any -> any any (msg:"SIS OTROS TCP NULL scan"; flags:0; classtype:attempted-recon; sid:1100807; rev:1;)
alert tcp any any -> any any (msg:"SIS OTROS TCP Xmas scan"; flags:FPU; classtype:attempted-recon; sid:1100808; rev:1;)
alert tcp any any -> any any (msg:"SIS OTROS TCP FIN scan"; flags:F; classtype:attempted-recon; sid:1100809; rev:1;)
alert tcp any any -> any any (msg:"SIS OTROS TCP SYN FIN scan"; flags:SF; classtype:attempted-recon; sid:1100810; rev:1;)
