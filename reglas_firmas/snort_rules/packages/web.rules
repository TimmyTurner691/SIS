# SIS expanded Snort rules - web.rules
# Starter SID block: 1100501-1100599. Expansion SID block: 1112001-1112199.
# Keep both ranges reserved for Web to prevent collisions with other SIS packages.
# Validate with `snort -T` and tune rate/noise thresholds after baselining.

# Original SIS starter rules (stable SIDs).
alert tcp any any -> any [80,8080,8000] (msg:"SIS Web intento traversal"; content:"../"; http_uri; sid:1100501; rev:1;)
alert tcp any any -> any [80,443,8080] (msg:"SIS Web SQL injection basica"; content:"union select"; nocase; sid:1100502; rev:1;)

# Expanded SIS rules (collision-free Web expansion block).
alert tcp any any -> any [80,81,88,443,8000,8008,8080,8081,8443,8888,9000,9443] (msg:"SIS WEB directory traversal dotdot slash"; flow:to_server,established; content:"../"; nocase; http_uri; classtype:web-application-attack; sid:1112001; rev:1;)
alert tcp any any -> any [80,81,88,443,8000,8008,8080,8081,8443,8888,9000,9443] (msg:"SIS WEB directory traversal encoded slash"; flow:to_server,established; content:"..%2f"; nocase; http_uri; classtype:web-application-attack; sid:1112002; rev:1;)
alert tcp any any -> any [80,81,88,443,8000,8008,8080,8081,8443,8888,9000,9443] (msg:"SIS WEB directory traversal double encoded slash"; flow:to_server,established; content:"%252e%252e%252f"; nocase; http_uri; classtype:web-application-attack; sid:1112003; rev:1;)
alert tcp any any -> any [80,81,88,443,8000,8008,8080,8081,8443,8888,9000,9443] (msg:"SIS WEB directory traversal windows backslash"; flow:to_server,established; content:"..|5C|"; nocase; http_uri; classtype:web-application-attack; sid:1112004; rev:1;)
alert tcp any any -> any [80,81,88,443,8000,8008,8080,8081,8443,8888,9000,9443] (msg:"SIS WEB directory traversal encoded backslash"; flow:to_server,established; content:"..%5c"; nocase; http_uri; classtype:web-application-attack; sid:1112005; rev:1;)
