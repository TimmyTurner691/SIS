# SIS expanded Snort rules - windows.rules
# Reserved SID block: 1100301-1100399.
# Keep this range exclusive to Windows to prevent collisions with other SIS packages.
# Validate with `snort -T` and tune rate/noise thresholds after baselining.

# Original SIS starter rules (stable SIDs).
alert tcp any any -> any 3389 (msg:"SIS Windows RDP detectado"; flags:S; sid:1100301; rev:1;)
alert tcp any any -> any 445 (msg:"SIS Windows SMB detectado"; flow:to_server; sid:1100302; rev:1;)

# Expanded SIS rules (collision-free Windows block).
alert tcp any any -> any 3389 (msg:"SIS WINDOWS RDP connection attempt"; flags:S; detection_filter:track by_src,count 10,seconds 60; classtype:policy-violation; sid:1100303; rev:1;)
alert tcp any any -> any 3389 (msg:"SIS WINDOWS possible RDP brute force scan"; flags:S; detection_filter:track by_src,count 40,seconds 120; classtype:attempted-admin; sid:1100304; rev:1;)
alert tcp any any -> any 5985 (msg:"SIS WINDOWS WinRM HTTP connection attempt"; flags:S; classtype:policy-violation; sid:1100305; rev:1;)
alert tcp any any -> any 5986 (msg:"SIS WINDOWS WinRM HTTPS connection attempt"; flags:S; classtype:policy-violation; sid:1100306; rev:1;)
alert tcp any any -> any 135 (msg:"SIS WINDOWS MSRPC endpoint mapper connection"; flags:S; detection_filter:track by_src,count 25,seconds 60; classtype:attempted-recon; sid:1100307; rev:1;)
alert tcp any any -> any 389 (msg:"SIS WINDOWS LDAP high connection rate possible enumeration"; flags:S; detection_filter:track by_src,count 50,seconds 60; classtype:attempted-recon; sid:1100308; rev:1;)
