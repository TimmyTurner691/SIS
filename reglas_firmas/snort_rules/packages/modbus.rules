# SIS expanded Snort rules - modbus.rules
# Starter SID block: 1100101-1100199. Expansion SID block: 1111001-1111199.
# Keep both ranges reserved for Modbus to prevent collisions with other SIS packages.
# Validate with `snort -T` and tune rate/noise thresholds after baselining.

# Original SIS starter rules (stable SIDs).
alert tcp any any -> any 502 (msg:"SIS Modbus escritura de bobina"; content:"|05|"; offset:7; depth:1; sid:1100101; rev:1;)
alert tcp any any -> any 502 (msg:"SIS Modbus escritura de registros"; content:"|10|"; offset:7; depth:1; sid:1100102; rev:1;)

# Expanded SIS rules (collision-free Modbus expansion block).
alert tcp any any -> any 502 (msg:"SIS MODBUS TCP connection attempt"; flags:S; classtype:policy-violation; sid:1111001; rev:1;)
alert tcp any any -> any 502 (msg:"SIS MODBUS high request rate possible polling abuse"; flow:to_server,established; detection_filter:track by_src,count 120,seconds 10; classtype:attempted-dos; sid:1111002; rev:1;)
alert tcp any any -> any 502 (msg:"SIS MODBUS protocol id zero observed"; flow:to_server,established; content:"|00 00|"; offset:2; depth:2; classtype:misc-activity; sid:1111003; rev:1;)
alert tcp any any -> any 502 (msg:"SIS MODBUS function 01 read coils"; flow:to_server,established; content:"|01|"; offset:7; depth:1; classtype:policy-violation; sid:1111004; rev:1;)
