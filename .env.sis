# --- Networking ---
SIS_CAPTURE_INTERFACE=br-siem 
SIS_MANAGEMENT_INTERFACE=lo
SIS_MANAGEMENT_BIND_IP=0.0.0.0
SIS_SENSOR_MODE=demo
SIS_SENSOR_PROMISCUOUS=true
SIS_DASHBOARD_PORT=8501
SIS_DASHBOARD_LISTEN_ADDRESS=0.0.0.0
SIS_DASHBOARD_INTERNAL_PORT=8501
SIS_PROXY_PORT=8080
SIS_REDIS_PORT=6379
SIS_ELASTIC_PORT=9200

# ── IP pública / de gestión del host ───────────────────────────────────────
# IMPORTANTE: Cambia este valor por la IP real de tu interfaz de gestión
# (normalmente ens4, eth0 o la que veas con: ip -4 addr show ens4).
# Ejemplo: SIS_PUBLIC_IP=192.168.122.45
# Esta IP es la que el BROWSER del cliente usa para llegar al proxy Nginx.
# En desarrollo local puedes dejarlo como "localhost".
SIS_PUBLIC_IP=192.168.122.X

# --- Service discovery inside Docker network ---
# Nombres DNS internos de Docker (válidos en siem_internal_net).
# IMPORTANTE: ya NO usar 127.0.0.1 porque cerebro ya no tiene network_mode:host.
SIS_REDIS_HOST=redis
SIS_ELASTIC_HOST=elasticsearch
SIS_REDIS_KEY=sis_queue
SIS_INDEX_NAME=sis-logs-v1

# --- Paths mounted by docker-compose ---
SIS_ZEEK_LOGS_PATH=./logs/logs_zeek
SIS_ZEEK_LIVE_LOGS_PATH=./logs/logs_zeek/logs/live
SIS_SNORT_LOGS_PATH=./logs/logs_snort
SIS_SNORT_CONF_PATH=./configuracion/snort/snort.conf
SIS_SNORT_RULES_PATH=./reglas_firmas/snort_rules
SIS_SENSOR_HEALTH_PATH=./logs/sensor_health
SIS_SURICATA_LOGS_PATH=./logs/logs_suricata
SIS_INVENTORY_PATH=/app/ot_inventory.json

# --- Elasticsearch tuning ---
SIS_ES_JAVA_OPTS=-Xms512m -Xmx512m

# --- SMTP (leave blank to disable email alerts) ---
SIS_SMTP_SERVER=smtp.gmail.com
SIS_SMTP_PORT=587
SIS_SMTP_SENDER_EMAIL=sis.segnet@gmail.com
SIS_SMTP_SENDER_PASSWORD=acdkyzfstwodtmlg
SIS_SMTP_RECEIVER_EMAIL=
SIS_SMTP_USE_TLS=true

# --- Dashboard runtime ---
SIS_DASHBOARD_ELASTIC_HOST=elasticsearch
SIS_DASHBOARD_ELASTIC_PORT=9200
SIS_DASHBOARD_REDIS_HOST=redis
SIS_DASHBOARD_REDIS_PORT=6379
SIS_DASHBOARD_INDEX=sis-logs-v1
SIS_DASHBOARD_INVENTORY_PATH=/app/ot_inventory.json
SIS_DASHBOARD_REPORT_PATH=/app/cve_report.csv
SIS_DASHBOARD_SCANNER_SCRIPT=/python_core/vuln_scanner.py
SIS_DIRECT_LOG_POLL_ENABLED=false